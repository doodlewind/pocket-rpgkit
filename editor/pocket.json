{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.lfkdsk.pocket-rpgkit-editor",
  "name": "pocket-rpgkit-editor",
  "title": "Pocket RPG Kit Editor",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "input.pointer",
        "input.text",
        "host.clipboard",
        "display.viewport.live",
        "data.fs"
      ]
    }
  },
  "app": {
    "entry": "editor/editor.tsx",
    "output": "editor",
    "framework": "solid",
    "companions": [
      "rpgkit-editor"
    ],
    "viewport": {
      "dynamic": {
        "default": [
          720,
          480
        ],
        "min": [
          400,
          240
        ]
      }
    }
  }
}
